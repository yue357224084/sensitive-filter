# sensitive-filter 环境变量模板（根目录 .env）
# 优先级：本文件中“未注释的 KEY” > 系统环境变量（程序启动时由 loadDotEnv 读取并覆盖）
# 本文件默认全部注释 → 程序行为 = 纯系统环境变量，仓库测试不受影响。
# 想启用某项：取消注释并按需改值；想用回系统变量：重新注释或删除该行。
# 注意：不要在这里写密码/token 等敏感值（敏感值用系统环境变量注入）。
#
# 生效范围：
#   - codex/proxy.mjs     读 根目录 .env，再被 codex/.env 覆盖（如存在）
#   - opencode 插件       读自身所在目录（plugins/）下的 .env；全局安装版读
#                         ~/.config/opencode/plugins/.env
#   - CLI / Python 对拍   读仓库根 .env
#   - SF_ONLY/SF_SKIP 只在 proxy 与插件路径生效，CLI 掩码管线不应用

# ---- codex 代理（codex/proxy.mjs）----

# 监听端口（默认 3141）
# SF_PROXY_PORT=3141

# 监听地址：不设 = 仅本机 127.0.0.1（代理无鉴权，默认不对内网开放）。
# 需内网访问时才显式设为具体内网 IP（如 10.0.0.1）；设 0.0.0.0/0.0.0.0 会启动告警。
# SF_PROXY_HOST=

# 上游 base_url：代理把掩码后的请求转发到这里（默认 OpenAI 官方；
# 实际部署改成你的服务商地址，如 https://your-gateway.example.com/v1）
# SF_UPSTREAM=https://api.openai.com/v1

# 请求体大小上限，单位 MB（默认 64）。超限 fail-closed 返回 413，避免整包进内存
# SF_MAX_BODY_MB=64

# 调试日志（1=开启；也可用启动参数 --debug）
# 输出掩码前/后的请求体与还原前/后的响应（含敏感明文）——仅本地排障，勿外传日志
# SF_PROXY_DEBUG=0

# 映射文件目录：占位符↔原值双向映射的落盘位置；不设 = 系统临时目录。
# 插件与 CLI 必须指向同一目录才能互相还原（与 CLI --map-out、插件 SF_MAP_DIR 一致）
# SF_MAP_DIR=

# 映射文件保留上限（默认 5000）：按容量清理最旧的映射。
# 注意：映射寿命必须 ≥ 会话上下文寿命，否则模型上下文里的旧占位符无法还原（仅告警，不静默改写）
# SF_MAP_KEEP=5000

# ---- 类别开关（对 proxy 与 opencode 插件生效）----

# 全局停用（1=停用；优先级高于 SF_ONLY/SF_SKIP）
# SF_OFF=1

# 只启用指定类别（逗号分隔，如 phone,ipv4,secret）
# SF_ONLY=phone,ipv4,secret

# 跳过指定类别（逗号分隔，排障时放行某类，如 ipv4）
# SF_SKIP=ipv4
